 /* Copies the back buffer into the layer's next drawable and presents it
    with the frame's command buffer. Returns false without a drawable. */
+/* Opt-in GD spatial upscaler. Framebuffer coordinates and game timing stay unchanged. */
+static double gd_fx_scale(void)
+{
+    static double scale = 0;
+    static dispatch_once_t once;
+    dispatch_once(&once, ^{
+        const char *value = getenv("GD_METALFX_SCALE");
+        double requested = value ? atof(value) : 1.0;
+        scale = requested == 1.5 || requested == 2.0 || requested == 10.0 || requested == 20.0 ? requested : 1.0;
+    });
+    return scale;
+}
+static id<MTLTexture> gd_fx_encode(struct glm_backend_context *b, id<MTLCommandBuffer> commands,
+                                  id<MTLTexture> input, NSUInteger width, NSUInteger height)
+{
+    if (@available(macOS 13.0, *)) {
+        if (![MTLFXSpatialScalerDescriptor supportsDevice:device]) return input;
+        if (!b->gd_fx || b->gd_fx.inputWidth != input.width || b->gd_fx.inputHeight != input.height ||
+            b->gd_fx.outputWidth != width || b->gd_fx.outputHeight != height ||
+            b->gd_fx.colorTextureFormat != input.pixelFormat) {
+            MTLFXSpatialScalerDescriptor *desc = [MTLFXSpatialScalerDescriptor new];
+            desc.inputWidth = input.width; desc.inputHeight = input.height;
+            desc.outputWidth = width; desc.outputHeight = height;
+            desc.colorTextureFormat = input.pixelFormat; desc.outputTextureFormat = input.pixelFormat;
+            desc.colorProcessingMode = MTLFXSpatialScalerColorProcessingModePerceptual;
+            b->gd_fx = [desc newSpatialScalerWithDevice:device];
+            if (!b->gd_fx) { fprintf(stderr, "gd-metalfx: scaler creation failed; using normal presentation\n"); return input; }
+            MTLTextureDescriptor *td = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:input.pixelFormat width:input.width height:input.height mipmapped:NO];
+            td.storageMode = MTLStorageModePrivate;
+            td.usage = b->gd_fx.colorTextureUsage;
+            b->gd_fx_input = [device newTextureWithDescriptor:td];
+            td.width = width; td.height = height; td.usage = b->gd_fx.outputTextureUsage | MTLTextureUsageShaderRead;
+            b->gd_fx_output = [device newTextureWithDescriptor:td];
+            b->gd_fx_reported = false;
+        }
+        if (!b->gd_fx_input || !b->gd_fx_output) return input;
+        id<MTLBlitCommandEncoder> copy = [commands blitCommandEncoder];
+        [copy copyFromTexture:input sourceSlice:0 sourceLevel:0 sourceOrigin:MTLOriginMake(0,0,0)
+                  sourceSize:MTLSizeMake(input.width,input.height,1) toTexture:b->gd_fx_input destinationSlice:0 destinationLevel:0 destinationOrigin:MTLOriginMake(0,0,0)];
+        [copy endEncoding];
+        b->gd_fx.colorTexture = b->gd_fx_input; b->gd_fx.outputTexture = b->gd_fx_output;
+        b->gd_fx.inputContentWidth = input.width; b->gd_fx.inputContentHeight = input.height;
+        [b->gd_fx encodeToCommandBuffer:commands];
+        if (!b->gd_fx_reported) {
+            b->gd_fx_reported = true;
+            NSUInteger iw=input.width, ih=input.height;
+            [commands addCompletedHandler:^(id<MTLCommandBuffer> done) {
+                fprintf(stderr,"gd-metalfx: %lux%lu -> %lux%lu GPU %s%s\n",(unsigned long)iw,(unsigned long)ih,(unsigned long)width,(unsigned long)height,
+                        done.status == MTLCommandBufferStatusCompleted ? "completed" : "FAILED ", done.error ? done.error.localizedDescription.UTF8String : "");
+            }];
+        }
+        return b->gd_fx_output;
+    }
+    return input;
+}
